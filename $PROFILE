function ff {
    param(
        # Accept the folder name as the first positional argument: ff <folder>.
        [Parameter(Position = 0)]
        [string]$Query,
        # Return the path instead of changing the current directory.
        [switch]$Print
    )
    if ([string]::IsNullOrWhiteSpace($Query)) {
        Write-Host "usage: ff <folder>"
        return
    }
    # Normalize once so all matching is case-insensitive.
    $q = $Query.ToLower()
    # Limit search roots. Edit these to your real folders.
    $roots = @(
        "$HOME\Desktop",
        "$HOME\Documents",
        "$HOME\Downloads",
        "$HOME\source",
        "$HOME\repos",
        "$HOME\projects"
    ) | Where-Object { Test-Path $_ }
    # Collect zoxide and filesystem results in a common shape for one ranking pass.
    $results = @()
    # 1) Recent-use ranking from zoxide
    if (Get-Command zoxide -ErrorAction SilentlyContinue) {
        try {
            $zMatches = zoxide query -l | Where-Object {
                $_.ToLower() -like "*$q*"
            }
            foreach ($p in $zMatches) {
                # zoxide may retain paths that no longer exist, so validate each entry.
                if (Test-Path $p) {
                    $item = Get-Item $p -ErrorAction SilentlyContinue
                    $results += [pscustomobject]@{
                        Path         = $p
                        Name         = [System.IO.Path]::GetFileName($p)
                        Source       = "zoxide"
                        Exact        = [int]([System.IO.Path]::GetFileName($p).ToLower() -eq $q)
                        ModifiedTime = if ($item) { $item.LastWriteTime } else { [datetime]::MinValue }
                    }
                }
            }
        }
        catch {
            # Treat an unavailable or misconfigured zoxide database as an optional feature.
        }
    }
    # 2) Filesystem fallback, but only in useful roots
    foreach ($root in $roots) {
        try {
            Get-ChildItem -Path $root -Directory -Recurse -ErrorAction SilentlyContinue |
            Where-Object {
                # Skip dependency, system, and metadata directories to keep the search useful and fast.
                $_.Name.ToLower() -like "*$q*" -and
                $_.FullName -notmatch '\\node_modules(\\|$)' -and
                $_.FullName -notmatch '\\\.git(\\|$)' -and
                $_.FullName -notmatch '\\AppData(\\|$)' -and
                $_.FullName -notmatch '\\Windows(\\|$)' -and
                $_.FullName -notmatch '\\Program Files(\\|$)' -and
                $_.FullName -notmatch '\\Program Files \(x86\)(\\|$)' -and
                $_.FullName -notmatch '\\scoop(\\|$)' -and
                $_.FullName -notmatch '\\npm-cache(\\|$)' -and
                $_.FullName -notmatch '\\.cargo(\\|$)' -and
                $_.FullName -notmatch '\\.venv(\\|$)' -and
                $_.FullName -notmatch '\\venv(\\|$)'
            } |
            Sort-Object LastWriteTime -Descending |
            # Bound every root's contribution so broad searches remain responsive.
            Select-Object -First 100 |
            ForEach-Object {
                $results += [pscustomobject]@{
                    Path         = $_.FullName
                    Name         = $_.Name
                    Source       = "fs"
                    Exact        = [int]($_.Name.ToLower() -eq $q)
                    ModifiedTime = $_.LastWriteTime
                }
            }
        }
        catch {
            # Continue with other roots if one is inaccessible or disappears during the scan.
        }
    }
    # Remove duplicate paths, then prefer exact names, zoxide matches, and recent folders.
    $ranked = $results |
    Sort-Object Path -Unique |
    Sort-Object `
    @{Expression = 'Exact'; Descending = $true }, `
    @{Expression = { $_.Source -eq 'zoxide' }; Descending = $true }, `
    @{Expression = 'ModifiedTime'; Descending = $true }
    if (-not $ranked) {
        Write-Host "no matches"
        return
    }
    # If fzf exists, pick interactively. Otherwise take the top result.
    if (Get-Command fzf -ErrorAction SilentlyContinue) {
        $chosen = $ranked.Path | fzf --height 40% --reverse --prompt "ff > "
    }
    else {
        $chosen = $ranked[0].Path
    }
    if (-not $chosen) {
        return
    }
    if ($Print) {
        # Emit the selected path for use in pipelines or scripts.
        $chosen
    }
    else {
        # Make interactive ff calls jump directly to the chosen folder.
        Set-Location $chosen
    }
}
