# Keep the profile self-updating before the rest of the shell setup runs.
function Invoke-ProfileSelfUpdate {
    param(
        # Defaults to the PowerShell profile currently being loaded.
        [string]$ProfilePath = $PROFILE,
        # Raw GitHub source used when automatic updates are enabled.
        [string]$SourceUrl = 'https://raw.githubusercontent.com/joeygallegos/joeygallegos/refs/heads/master/%24PROFILE'
    )
    # Do nothing when PowerShell has not created a local profile yet.
    if (-not (Test-Path -LiteralPath $ProfilePath)) {
        return
    }
    # Download to a unique temporary file so the active profile is never partially replaced.
    $tempPath = Join-Path $env:TEMP ('profile-update-{0}.ps1' -f ([guid]::NewGuid().ToString('N')))
    # Leave disabled unless this machine should check GitHub at every shell startup.
    $checkForUpdate = $false
    if ($checkForUpdate) {
        try {
            # Stop immediately on a download failure so the current profile remains usable.
            Invoke-WebRequest -Uri $SourceUrl -OutFile $tempPath -ErrorAction Stop
            # Compare file contents rather than timestamps before overwriting the profile.
            $localHash = (Get-FileHash -LiteralPath $ProfilePath -Algorithm SHA256 -ErrorAction Stop).Hash
            $remoteHash = (Get-FileHash -LiteralPath $tempPath -Algorithm SHA256 -ErrorAction Stop).Hash
            if ($localHash -ne $remoteHash) {
                Copy-Item -LiteralPath $tempPath -Destination $ProfilePath -Force
                Write-Host 'Profile update downloaded. Restarting PowerShell...' -ForegroundColor Yellow
                Start-Sleep -Seconds 2
                # Prefer the current PowerShell installation when opening the refreshed session.
                $shell = Join-Path $PSHOME 'pwsh.exe'
                if (Test-Path -LiteralPath $shell) {
                    Start-Process -FilePath $shell -ArgumentList @('-NoLogo') -WorkingDirectory (Get-Location).Path -NoNewWindow
                    exit
                }
            }
        }
        catch {
            # Keep the shell usable if the update check fails.
        }
        finally {
            # Remove the temporary download whether the update succeeded, failed, or was unnecessary.
            Remove-Item -LiteralPath $tempPath -Force -ErrorAction SilentlyContinue
        }
    }
}
