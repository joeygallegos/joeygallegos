function New-StarLine {
    param(
        [int]$Width,
        [double]$Density = 0.08
    )
    # Characters are sampled sparsely to create a simple star-field effect.
    $chars = @('.', '+', '*', "'", '`')
    $lineChars = for ($i = 0; $i -lt $Width; $i++) {
        if ((Get-Random -Minimum 0.0 -Maximum 1.0) -lt $Density) {
            $chars | Get-Random
        }
        else {
            ' '
        }
    }
    # Return one string so callers can write the complete visual line at once.
    -join $lineChars
}
function Show-MOTD {
    # Redraw the terminal before displaying the startup dashboard.
    Clear-Host
    # Named colors keep the sections visually consistent.
    $accent = "Cyan"
    $muted = "DarkGray"
    $good = "Green"
    $gold = "`e[38;2;255;215;0m"
    $reset = "`e[0m"
    # Keep the title, border, and star field aligned to one shared width.
    $width = 46
    $title = "IN A TERMINAL FAR, FAR AWAY..."
    $border = "━" * $width
    # Render the Star Wars-inspired header and surrounding star field.
    Write-Host "$gold$border$reset"
    Write-Host (New-StarLine -Width $width)
    Write-Host (New-StarLine -Width $width)
    Write-Host ($title.PadLeft(([math]::Floor(($width + $title.Length) / 2))).PadRight($width)) -ForegroundColor Yellow
    Write-Host (New-StarLine -Width $width)
    Write-Host (New-StarLine -Width $width)
    Write-Host "$gold$border$reset"
    # Display a small snapshot of the current interactive session.
    Write-Host "`nSYSTEM" -ForegroundColor $accent
    Write-Host "  User : " -NoNewline; Write-Host "$env:USERNAME" -ForegroundColor $good
    Write-Host "  Host : " -NoNewline; Write-Host "$env:COMPUTERNAME" -ForegroundColor $good
    Write-Host "  Time : " -NoNewline; Write-Host "$(Get-Date -Format 'ddd, MMM d yyyy  →  h:mm tt')" -ForegroundColor $good
    # Display frequently used commands with aligned descriptions.
    Write-Host "`nCOMMANDS" -ForegroundColor $accent
    $cmdWidth = 18
    $commands = @(
        @{ Cmd = "ff <name>"; Desc = "jump to folder" },
        @{ Cmd = "git status"; Desc = "repo state" },
        @{ Cmd = 'code $PROFILE'; Desc = "edit this motd" }
    )
    if (Test-Path -LiteralPath $keyBridgeScript -PathType Leaf) {
        # Advertise connect only when the corresponding command was registered above.
        $commands += @{ Cmd = "connect"; Desc = "SSH via KeyBridge" }
    }
    foreach ($item in $commands) {
        # Pad command names so descriptions share a consistent column.
        $left = $item.Cmd.PadRight($cmdWidth)
        Write-Host "  $left" -NoNewline -ForegroundColor $good
        Write-Host "  →  $($item.Desc)" -ForegroundColor $muted
    }
    # Optional: recent dirs (clickable)
    if (Get-Command zoxide -ErrorAction SilentlyContinue) {
        Write-Host "`nRECENT  " -NoNewline -ForegroundColor $accent
        Write-Host "(Ctrl+Click to open)" -ForegroundColor $muted
        zoxide query -l | Select-Object -First 3 | ForEach-Object {
            $path = $_
            # OSC 8 uses forward-slash file URIs for clickable terminal links.
            $uri = "file:///" + ($path -replace '\\', '/')
            $link = "`e]8;;$uri`e\$path`e]8;;`e\"
            Write-Host "  $link" -ForegroundColor $muted
        }
    }
    # Finish the dashboard with a clean prompt line.
    Write-Host ""
}
# Display the startup dashboard after all optional commands have been registered.
Show-MOTD
